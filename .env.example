# Token Bot Discord (Didapatkan dari Discord Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=your_bot_token_here

# Client ID Aplikasi Discord (Didapatkan dari General Information -> Application ID)
CLIENT_ID=your_client_id_here
# (Opsional) Guild / Server ID Discord untuk testing cepat (Slash command muncul detik itu juga)
GUILD_ID=

# Prefix untuk perintah teks biasa (misal: !play)
PREFIX=!

# Volume bawaan bot (0 - 100; 0 = mute)
DEFAULT_VOLUME=50

# YouTube proxy rotation. Keep credentials in the ignored data file.
# One entry per line: host:port:username:password
YOUTUBE_PROXY_FILE=data/youtube-proxies.txt
# Optional inline entries; the file and this value are combined.
YOUTUBE_PROXIES=
YOUTUBE_PROXY_COOLDOWN_MS=60000
YOUTUBE_PROXY_FAILURE_COOLDOWN_MS=600000

# SQLite persistence
DATABASE_PATH=data/vibes.sqlite

# Optional Discord OAuth2 dashboard
DASHBOARD_ENABLED=false
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8787
# Set this to the public HTTPS URL only when a TLS reverse proxy is configured.
DASHBOARD_PUBLIC_URL=https://dashboard.example.com
DASHBOARD_CLIENT_ID=
DASHBOARD_CLIENT_SECRET=
DASHBOARD_SESSION_SECRET=replace-with-a-long-random-secret
