# Token Bot Discord (Didapatkan dari Discord Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=your_bot_token_here

# Client ID Aplikasi Discord (Didapatkan dari General Information -> Application ID)
CLIENT_ID=your_client_id_here

# Prefix untuk perintah teks biasa (misal: !play)
PREFIX=!

# Volume bawaan bot (1 - 100)
DEFAULT_VOLUME=50
