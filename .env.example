# Token Bot Discord (Didapatkan dari Discord Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=your_bot_token_here

# Client ID Aplikasi Discord (Didapatkan dari General Information -> Application ID)
CLIENT_ID=your_client_id_here
# (Opsional) Guild / Server ID Discord untuk testing cepat (Slash command muncul detik itu juga)
GUILD_ID=

# Prefix untuk perintah teks biasa (misal: !play)
PREFIX=!

# Volume bawaan bot (0 - 100; 0 = mute)
DEFAULT_VOLUME=50

# YouTube proxy rotation. Keep credentials in the ignored data file.
# One entry per line: host:port:username:password
YOUTUBE_PROXY_FILE=data/youtube-proxies.txt
# Optional inline entries; the file and this value are combined.
YOUTUBE_PROXIES=
YOUTUBE_PROXY_COOLDOWN_MS=60000
YOUTUBE_PROXY_FAILURE_COOLDOWN_MS=600000

# SQLite persistence
DATABASE_PATH=data/vibes.sqlite
# Backup output directory and number of snapshots to retain.
DATABASE_BACKUP_DIR=backups
DATABASE_BACKUP_RETENTION=14

# Optional Discord OAuth2 dashboard
DASHBOARD_ENABLED=false
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8787
# Set this to the public HTTPS URL only when a TLS reverse proxy is configured.
DASHBOARD_PUBLIC_URL=https://dashboard.example.com
DASHBOARD_CLIENT_ID=
DASHBOARD_CLIENT_SECRET=
DASHBOARD_SESSION_SECRET=replace-with-a-long-random-secret

# ─── Honeypot Anti-Scam ───────────────────────────────────────────────────────
# Aksi saat honeypot terpicu:
#   ban      = ban permanen, Discord menghapus riwayat server-side (default)
#   ban-kick = ban sebentar lalu auto-unban; riwayat tetap dihapus Discord
#   kick     = kick + purge manual per channel (thread tidak dipindai)
HONEYPOT_ACTION=ban
# Channel jebakan: satu pesan di sini = ban/kick + hapus pesan user 24 jam terakhir.
# Daftar ID channel dipisah koma. Kosongkan untuk menonaktifkan fitur.
HONEYPOT_CHANNEL_IDS=
# Role yang boleh menulis di channel honeypot tanpa diban (mis. staff/QA).
HONEYPOT_EXEMPT_ROLE_IDS=
# User ID yang dikecualikan (opsional).
HONEYPOT_EXEMPT_USER_IDS=
# Channel laporan ban (opsional).
HONEYPOT_LOG_CHANNEL_ID=
# Rentang riwayat yang dihapus, dalam detik (0-604800, default 86400 = 24 jam).
# Mode kick butuh izin View Channel + Read Message History + Manage Messages.
HONEYPOT_DELETE_WINDOW_SECONDS=86400
